# PostgreSQL (Supabase yoki boshqa)
DATABASE_URL=postgresql://user:password@host:port/dbname

# JWT — kamida 32 belgili tasodifiy qiymat
# Generatsiya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-this

# Server
PORT=4000
CLIENT_URL=http://localhost:5173

# Bunny.net CDN
BUNNY_API_KEY=
BUNNY_STORAGE_ZONE=
BUNNY_HOSTNAME=storage.bunnycdn.com
BUNNY_CDN_URL=

# Groq API (bepul: console.groq.com)
GROQ_API_KEY=

# Telegram Bot (@BotFather dan oling)
TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_ENABLED=true

# Daily.co (video uchrashuvlar)
DAILY_API_KEY=

# Web Push VAPID kalitlari (npm run vapid bilan generatsiya qiling)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# App
NODE_ENV=development
